{
	"name": "riyal",
	"version": "1.1.0",
	"description": "The Saudi Riyal currency symbol (U+20C1) as a web font, CSS utility, React, Vue 3, Svelte 5, React Native, and Web Component, with a Tailwind plugin, Next.js font helper, OG cards, VAT helpers, and currency conversion.",
	"license": "MIT",
	"author": "Pooya Golchian",
	"homepage": "https://riyal.js.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pooyagolchian/riyal.git",
		"directory": "packages/riyal-symbol"
	},
	"bugs": {
		"url": "https://github.com/pooyagolchian/riyal/issues"
	},
	"keywords": [
		"riyal",
		"saudi riyal",
		"saudi riyal symbol",
		"saudi riyal sign",
		"sar",
		"sar symbol",
		"saudi arabia",
		"ksa",
		"u+20c1",
		"u20c1",
		"currency",
		"currency symbol",
		"symbol",
		"unicode",
		"font",
		"web font",
		"icon",
		"react",
		"react-native",
		"vue",
		"vue3",
		"nuxt",
		"svelte",
		"svelte5",
		"sveltekit",
		"web component",
		"tailwind",
		"next.js",
		"css",
		"scss",
		"arabic",
		"rtl",
		"payment",
		"fintech",
		"vat",
		"intl",
		"formatting",
		"copy clipboard",
		"e-commerce",
		"ecommerce",
		"checkout",
		"next.js font",
		"og image",
		"saudi green",
		"sama"
	],
	"type": "module",
	"sideEffects": ["./dist/web-component/*", "*.css", "*.scss"],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"riyal": "./dist/cli/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js",
			"require": "./dist/react/index.cjs"
		},
		"./react-native": {
			"types": "./dist/react-native/index.d.ts",
			"import": "./dist/react-native/index.js",
			"require": "./dist/react-native/index.cjs"
		},
		"./vue": {
			"types": "./dist/vue/index.d.ts",
			"import": "./dist/vue/index.js",
			"require": "./dist/vue/index.cjs"
		},
		"./svelte": {
			"svelte": "./src/svelte/index.ts",
			"types": "./src/svelte/index.ts",
			"default": "./src/svelte/index.ts"
		},
		"./web-component": {
			"types": "./dist/web-component/index.d.ts",
			"import": "./dist/web-component/index.js"
		},
		"./tailwind": {
			"types": "./dist/tailwind/index.d.ts",
			"import": "./dist/tailwind/index.js",
			"require": "./dist/tailwind/index.cjs"
		},
		"./next": {
			"types": "./dist/next/index.d.ts",
			"import": "./dist/next/index.js",
			"require": "./dist/next/index.cjs"
		},
		"./og": {
			"types": "./dist/og/index.d.ts",
			"import": "./dist/og/index.js",
			"require": "./dist/og/index.cjs"
		},
		"./css": "./dist/css/riyal.css",
		"./scss": "./src/scss/riyal.scss",
		"./font/woff2": "./dist/fonts/riyal.woff2",
		"./font/woff": "./dist/fonts/riyal.woff",
		"./font/ttf": "./dist/fonts/riyal.ttf",
		"./font/sans/woff2": "./dist/fonts/riyal-sans.woff2",
		"./font/serif/woff2": "./dist/fonts/riyal-serif.woff2",
		"./font/mono/woff2": "./dist/fonts/riyal-mono.woff2",
		"./font/arabic/woff2": "./dist/fonts/riyal-arabic.woff2",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src/scss",
		"src/svelte/*.svelte",
		"src/svelte/index.ts",
		"src/svelte/glyph.ts",
		"src/svelte/riyalRate.svelte.ts",
		"src/constants.ts",
		"src/format.ts",
		"src/conversion.ts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "pnpm run build:fonts && tsup && pnpm run copy:assets",
		"copy:assets": "node scripts/copy-assets.mjs",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"build:fonts": "node scripts/build-fonts.mjs"
	},
	"peerDependencies": {
		"next": ">=13",
		"react": ">=18",
		"react-dom": ">=18",
		"react-native": ">=0.72",
		"react-native-svg": ">=13",
		"svelte": ">=5",
		"tailwindcss": ">=3",
		"vue": ">=3.4"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"react-native": {
			"optional": true
		},
		"react-native-svg": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@riyal/tsconfig": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/react": "^16.0.1",
		"@testing-library/svelte": "^5.2.4",
		"@types/node": "^22.7.5",
		"@types/react": "^18.3.11",
		"@types/react-dom": "^18.3.0",
		"@vue/test-utils": "^2.4.6",
		"happy-dom": "^15.7.4",
		"next": "^14.2.15",
		"opentype.js": "^1.3.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"svelte": "^5.0.0",
		"tsup": "^8.3.0",
		"typescript": "^5.6.3",
		"vitest": "^2.1.2",
		"vue": "^3.4.0",
		"wawoff2": "^2.0.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
